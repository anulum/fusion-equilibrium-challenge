# Fusion Equilibrium Challenge — reviewed public source projection
# Allow-list: nothing is tracked unless it is named here after review.
# Everything made for the challenge lives in this directory; the public mirror gets only the reviewed paths below.
/*
!/.gitignore
!/README.md
!/LICENSE
!/NOTICE.md
!/REUSE.toml
!/LICENSES/
!/GOVERNANCE.md
!/CONTRIBUTORS.md
!/ARCHITECTURE.md
!/VALIDATION.md
!/CHANGELOG.md
!/Makefile
!/.editorconfig
!/.gitattributes
!/CITATION.cff
!/DATA_PROVENANCE.md
!/TRAINING.md
!/COMPUTE.md
!/infer.py
!/train.py
!/tree_replica.py
!/fetch_weights.py
!/deployment.json
!/training_recipe.json
!/WEIGHTS.json
!/WEIGHTS.sha256
!/.github/
!/.zenodo.json
!/.zenodo.json.license
!/pyproject.toml
!/.pre-commit-config.yaml
!/requirements-quality.txt
!/tests/
!/tools/
!/notebooks/
!/SECURITY.md
!/SUPPORT.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/requirements-inference-cpu.txt
!/requirements-training-cpu.txt
!/requirements-training-cuda.txt
!/source/
!/training_adapter/
!/docs/
/docs/*
!/docs/METHODS_REPORT.md
!/docs/COSTS.md
!/docs/EXPERIMENT_LEDGER.md
!/docs/STUDY.md
!/docs/NEGATIVE_RESULTS.md
!/docs/index.md
!/docs/AUDIT_TOOL.md
!/docs/AUDIT_CALIBRATION.md
!/docs/_config.yml
!/docs/_includes/
!/docs/robots.txt
!/docs/.well-known/
!/docs/assets/
!/docs/figures/
# models/ holds the trained weights: fetched by fetch_weights.py, never committed here
!/experiments/
# experiments/ is generated by private/tooling/make_public_experiments.py and scanned before every commit
# private/ stays untracked
docs/internal/
docs/internal/**
__pycache__/
*.pyc
